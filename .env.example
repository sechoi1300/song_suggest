# Copy to .env.local. See SETUP.md for Supabase setup.
# Copy the exact Session pooler URI from Supabase's Connect dialog (port 5432).
# Replace the password with the URL-encoded database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional CLI-only connection for migrations when DATABASE_URL uses port 6543.
# Use the Session pooler (5432) here on IPv4 networks.
DIRECT_URL=""

# NextAuth Configuration
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth Providers
# Register each OAuth app and set BOTH values to enable its sign-in button.
# Google callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub callback: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""
