// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  wantToListen  WantToListen[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Album {
  id            String         @id @default(cuid())
  title         String
  artist        String[]       // Array of artist names
  releaseDate   DateTime
  releaseYear   Int?
  length        String?        // e.g., "45:30"
  numSongs      Int?
  genres        String[]       // Array of genre names
  coverImageUrl String?
  spotifyUrl    String?
  tracklist     String[]       // Array of track titles
  averageRating Float?
  reviewCount   Int            @default(0)
  reviews       Review[]
  wantToListen  WantToListen[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([title])
  @@index([genres])
  @@index([averageRating])
}

model Review {
  id             String   @id @default(cuid())
  userId         String
  albumId        String
  rating         Float    // 0.0-10.0 scale (Beli exact decimal score, e.g. 9.3)
  rank           Int?     // Personal leaderboard rank (#1, #2, #3, ...)
  tier           String?  // "EXCEPTIONAL" (9.0+), "GREAT" (8.0-8.9), "GOOD" (7.0-7.9), "MEDIOCRE" (6.0-6.9), "SKIP" (<6.0)
  favoriteTracks String[] // Standout tracks chosen by user
  skipTrack      String?  // Least favorite track
  vibes          String[] // Moods/vibes e.g. ["Late Night", "Melancholy", "Summer Drive", "Focus"]
  listenAgain    String?  // "DEFINITELY", "MAYBE", "NO"
  listenedWith   String?  // "Headphones", "Vinyl", "Car", "Late Night", etc.
  reviewText     String?  @db.Text
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album          Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, albumId]) // One review per user per album
  @@index([albumId])
  @@index([userId])
}

model WantToListen {
  id        String   @id @default(cuid())
  userId    String
  albumId   String
  notes     String?  // e.g. "Friend recommendation", "Grammy nominee"
  priority  String?  // "HIGH", "NORMAL", "LOW"
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, albumId])
  @@index([userId])
  @@index([albumId])
}
